# Django (the older names SECRET_KEY and DEBUG also work)
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
# Comma-separated; only needed when deploying (see "Demo deployment" in the README).
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DB_PATH=/tmp/demo.sqlite3

# RabbitMQ (see docker-compose.yml)
RABBITMQ_HOST=localhost

# LLM (core/llm.py): LLM_PROVIDER is "openai" or "ollama"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
